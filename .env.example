# =====================================================================
# AcessaCidade — exemplo de variáveis de ambiente
# Copie para ".env" (que NÃO é versionado) e ajuste os valores.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# NUNCA coloque chaves reais neste arquivo de exemplo.
# =====================================================================

# --- Aplicação -------------------------------------------------------
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
# Pasta onde ficam o banco SQLite e as fotos enviadas (criada automaticamente)
DATA_DIR=./data/runtime
# Caminho do banco SQLite (vazio = DATA_DIR/acessacidade.db)
DATABASE_PATH=
# Tamanho máximo da fotografia enviada (MB)
MAX_UPLOAD_MB=5
# Carregar denúncias de demonstração (todas marcadas como SIMULADAS) na primeira inicialização
SEED_DEMO_DATA=true
# Cidade usada quando o cidadão não informa uma (texto livre)
CIDADE_PADRAO=
# Limite de requisições por minuto por IP nos endpoints de escrita e no assistente
RATE_LIMIT_PER_MINUTE=30
# Origens extras permitidas para CORS (separadas por vírgula). Vazio = somente a mesma origem.
ALLOWED_ORIGINS=

# --- Tokens internos (gere valores longos e aleatórios) --------------
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Token da equipe para alterar status/revisar denúncias (vazio = funcionalidade desativada)
ADMIN_TOKEN=
# Token usado pelo pipeline de dados para exportar denúncias e publicar a camada Gold (vazio = desativado)
PIPELINE_TOKEN=

# --- Assistente de IA (OpenRouter) ------------------------------------
# Sem chave, o assistente funciona em modo alternativo (respostas baseadas em regras).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ASSISTANT_TIMEOUT_SECONDS=20

# Prompts do assistente (vazio = 01-Generative-AI-Engineering/prompts)
ASSISTANT_PROMPTS_DIR=
# Pasta de fotos sintéticas usadas pelo seed de demonstração (vazio = data/samples/fotos)
SEED_FOTOS_DIR=
# Pasta do frontend servido pelo backend (vazio = app/frontend)
FRONTEND_DIR=
